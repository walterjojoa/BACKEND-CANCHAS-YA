      "type": "string"
    },
    {
      "key": "diaSemana",
      "value": "",
      "type": "string"
    },
    {
      "key": "horaInicio",
      "value": "18",
      "type": "string"
    },
    {
      "key": "horaFin",
      "value": "19",
      "type": "string"
    },
    {
      "key": "horaWompi",
      "value": "20",
      "type": "string"
    },
    {
      "key": "horaWompiFin",
      "value": "21",
      "type": "string"
    },
    {
      "key": "wompiReference",
