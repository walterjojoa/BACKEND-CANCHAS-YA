{
  "info": {
    "name": "CanchaYa Pasto API",
    "description": "Colección del backend de CanchaYa Pasto (Spring Boot). Elige el entorno \"CanchaYa - Render\" o \"CanchaYa - Local\" y ejecuta las carpetas en orden (Runner). Los logins guardan los tokens solos. Usuarios demo: player@canchaya.co / owner@canchaya.co, clave canchaya123.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Fecha de mañana y día de la semana (para horario y reservas)",
          "const d = new Date(Date.now() + 24*3600*1000);",
          "const pad = n => String(n).padStart(2, '0');",
          "if (!pm.collectionVariables.get('fecha')) pm.collectionVariables.set('fecha', `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`);",
          "const f = new Date(pm.collectionVariables.get('fecha') + 'T12:00:00');",
          "pm.collectionVariables.set('diaSemana', ['SUNDAY','MONDAY','TUESDAY','WEDNESDAY','THURSDAY','FRIDAY','SATURDAY'][f.getDay()]);"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "playerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "ownerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "fieldId",
      "value": "",
      "type": "string"
    },
